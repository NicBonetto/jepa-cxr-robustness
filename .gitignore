# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Tooling caches
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Data — never commit (PhysioNet DUA forbids redistribution)
data/
*.dcm
*.png
*.jpg
# Exceptions: README/docs images and summary figures (results/raw/ stays ignored).
# Git has no inline comments, so keep these on their own lines.
!docs/**/*.png
!results/**/*.png

# Embeddings, checkpoints, results artifacts
embeddings/
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.parquet
*.npz
results/raw/

# Secrets / cloud credentials
.env
*.json.key
service-account*.json

# OS / editor
.DS_Store
.idea/
